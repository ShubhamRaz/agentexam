generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("STUDENT") // STUDENT | TEACHER | ADMIN
  isActive     Boolean   @default(true)
  enrollmentNo String?
  semester     String?
  department   String?
  examDate     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Subject {
  id          String       @id @default(uuid())
  name        String
  code        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  units       Unit[]
  questions   Question[]
  materials   Material[]
  experiments Experiment[]
}

model Unit {
  id        String   @id @default(uuid())
  subjectId String
  name      String
  chapterNo Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id           String @id @default(uuid())
  unitId       String
  name         String
  importance   String @default("medium") // high | medium | low
  pyqFrequency Int    @default(0)
  weightage    Float  @default(0) // out of 20
  unit         Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Material {
  id               String   @id @default(uuid())
  subjectId        String
  uploadedBy       String
  materialType     String   // SYLLABUS | PYQ | NOTES | LAB_MANUAL
  title            String
  fileName         String
  fileType         String
  mimeType         String
  fileSize         Int
  processingStatus String   @default("PROCESSED") // UPLOADED | PROCESSING | PROCESSED | FAILED
  createdAt        DateTime @default(now())
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Question {
  id              String   @id @default(uuid())
  subjectId       String
  unitId          String?
  topicId         String?
  questionType    String   // MCQ | SHORT_ANSWER | LONG_ANSWER | VIVA
  questionText    String
  options         String?  // JSON [{id,text,is_correct}]
  correctAnswer   String?  // MCQ: option id
  explanation     String?
  marks           Float    @default(1)
  difficultyLevel String   @default("MEDIUM") // EASY | MEDIUM | HARD
  source          String   @default("MANUAL") // PYQ | MANUAL | AI
  sourceReference String?
  year            Int?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  answers         Answer[]
}

model MockTest {
  id              String    @id @default(uuid())
  studentId       String
  subjectId       String
  testType        String    @default("THEORY") // THEORY | PRACTICAL | VIVA
  difficultyLevel String    @default("MEDIUM")
  totalMarks      Float     @default(0)
  durationMinutes Int       @default(60)
  status          String    @default("DRAFT") // DRAFT | IN_PROGRESS | SUBMITTED | EVALUATED | EXPIRED
  questionIds     String    @default("[]") // JSON array of question ids
  startedAt       DateTime?
  expiresAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  answers         Answer[]
  result          Result?
}

model Answer {
  id               String    @id @default(uuid())
  questionId       String
  studentId        String
  testId           String
  answerText       String?
  selectedOptionId String?
  marksObtained    Float?
  feedback         String?
  answeredAt       DateTime  @default(now())
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test             MockTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Result {
  id            String   @id @default(uuid())
  testId        String   @unique
  studentId     String
  totalMarks    Float
  obtainedMarks Float
  percentage    Float
  grade         String?
  passStatus    Boolean  @default(false)
  analytics     String?  // JSON {improvement_suggestions, weak_areas, strong_areas, topic_scores}
  createdAt     DateTime @default(now())
  test          MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Experiment {
  id             String  @id @default(uuid())
  subjectId      String
  title          String
  description    String
  objective      String?
  instructions   String?
  expectedOutput String?
  marks          Float   @default(10)
  subject        Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id        String   @id @default(uuid())
  studentId String
  startDate DateTime
  endDate   DateTime
  planJson  String   @default("{}") // JSON days -> tasks
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}
